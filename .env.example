# NexaMart configuration reference.
# Copy these values into src/main/resources/config.properties (not committed).
# Never commit real passwords or secrets.

db.url=jdbc:h2:tcp://localhost:9092/./nexamart
db.user=sa
db.password=
db.driver=org.h2.Driver
hikari.maxPoolSize=10

# Chatbot provider: mock (default). A real provider is future scope.
ai.chatbot.provider=mock
